      "typeVersion": 1.8,
      "position": [740, 400],
      "notes": "After import: paste support-l1-system.txt into the system message."
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json.message?.content || items[0].json.text || items[0].json.output || JSON.stringify(items[0].json);\nconst s = String(raw);\nconst start = s.indexOf('{');\nconst end = s.lastIndexOf('}');\nif (start < 0 || end < 0) throw new Error('No JSON in LLM output: ' + s.slice(0, 200));\nconst parsed = JSON.parse(s.slice(start, end + 1));\nconst prev = $('Normalize Fields').item.json;\nreturn [{ json: { ...prev, ai: parsed } }];"
      },
